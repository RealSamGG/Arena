; ======== EDIT MODE (manual box move/resize) ========
global editMode := false
global editRects := []     ; live working copy of rects
global editSel := 1        ; selected rect index (1..4)

; ---------- HOTKEYS ----------
F1::ToggleRun()
F2::Calibrate()
F3::RefreshList()
F4::ScanPreview()
F5::SelfTestTesseract()
F6::ToggleOverlay()
F7::FlashOverlay()
