; ---------- SCOPED HOTKEYS (EDIT MODE) ----------
#HotIf editMode
Up::NudgeSel(0, -Step())
Down::NudgeSel(0, Step())
Left::NudgeSel(-Step(), 0)
Right::NudgeSel(Step(), 0)

+Up::NudgeSel(0, -Step(true))
+Down::NudgeSel(0, Step(true))
+Left::NudgeSel(-Step(true), 0)
+Right::NudgeSel(Step(true), 0)

^Up::ResizeSel(0, -Step())
^Down::ResizeSel(0, Step())
^Left::ResizeSel(-Step(), 0)
^Right::ResizeSel(Step(), 0)

^+Up::ResizeSel(0, -Step(true))
^+Down::ResizeSel(0, Step(true))
^+Left::ResizeSel(-Step(true), 0)
